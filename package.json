{
  "name": "qitabe-noor",
  "version": "1.0.0",
  "main": "App.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "doctor": "expo-doctor",
    "assets": "node scripts/generate-assets.js",
    "server": "node server/server.js",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android",
    "dev": "concurrently --names \"API,APP\" --prefix-colors \"cyan,magenta\" \"npm:server\" \"npm:start\"",
    "server:migrate": "node server/migrations/run.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm run lint && npm test && npm run doctor",
    "verify:deploy": "node scripts/verify-deployment.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/drawer": "^6.7.2",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "expo": "~52.0.23",
    "expo-av": "~15.0.2",
    "expo-blur": "~14.0.1",
    "expo-build-properties": "~0.13.3",
    "expo-device": "~7.0.3",
    "expo-file-system": "~18.0.12",
    "expo-haptics": "~14.0.0",
    "expo-linear-gradient": "~14.0.1",
    "expo-location": "~18.0.7",
    "expo-notifications": "~0.29.9",
    "expo-sensors": "~14.0.2",
    "expo-sharing": "~13.0.1",
    "expo-speech": "~13.0.0",
    "expo-status-bar": "~2.0.0",
    "firebase": "^12.15.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^12.9.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~8.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~52.0.6",
    "react-test-renderer": "^18.3.1",
    "supertest": "^7.2.2"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av",
          "firebase"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "jest": {
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "setupFilesAfterEnv": [
          "<rootDir>/jest.setup.js"
        ],
        "transformIgnorePatterns": [
          "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
        ],
        "testPathIgnorePatterns": [
          "<rootDir>/node_modules/",
          "<rootDir>/server/"
        ]
      },
      {
        "displayName": "server",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/server/**/__tests__/**/*.test.js"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/server/jest.setup.js"
        ]
      }
    ],
    "collectCoverageFrom": [
      "src/services/**/*.js",
      "src/data/curriculum.js"
    ]
  }
}
