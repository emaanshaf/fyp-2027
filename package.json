{
  "name": "qitabe-noor",
  "version": "1.0.0",
  "main": "App.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "doctor": "expo-doctor",
    "assets": "node scripts/generate-assets.js",
    "server": "node server/server.js",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android",
    "dev": "concurrently --names \"API,APP\" --prefix-colors \"cyan,magenta\" \"npm:server\" \"npm:start\"",
    "server:migrate": "node server/migrations/run.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm run lint && npm test && npm run doctor",
    "verify:deploy": "node scripts/verify-deployment.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/drawer": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "^57.0.0",
    "expo-av": "~15.0.2",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-location": "~57.0.15",
    "expo-notifications": "~57.0.16",
    "expo-sensors": "~57.0.2",
    "expo-sharing": "~57.0.17",
    "expo-speech": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.15.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.3.3",
    "babel-preset-expo": "^57.0.10",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "supertest": "^7.2.2",
    "react-test-renderer": "19.2.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av",
          "firebase"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "jest": {
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "setupFilesAfterEnv": [
          "<rootDir>/jest.setup.js"
        ],
        "transformIgnorePatterns": [
          "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
        ],
        "testPathIgnorePatterns": [
          "<rootDir>/node_modules/",
          "<rootDir>/server/"
        ]
      },
      {
        "displayName": "server",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/server/**/__tests__/**/*.test.js"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/server/jest.setup.js"
        ]
      }
    ],
    "collectCoverageFrom": [
      "src/services/**/*.js",
      "src/data/curriculum.js"
    ]
  }
}
