{
  "name": "qitabe-noor",
  "version": "1.0.0",
  "private": true,
  "description": "Qitab-e-Noor monorepo. frontend/ is the Expo app, backend/ is the Express API.",
  "scripts": {
    "start": "npm --prefix frontend start",
    "setup": "npm install && npm --prefix frontend install && npm --prefix backend install",
    "android": "npm --prefix frontend run android",
    "ios": "npm --prefix frontend run ios",
    "web": "npm --prefix frontend run web",
    "server": "npm --prefix backend start",
    "server:migrate": "npm --prefix backend run migrate",
    "dev": "concurrently --names \"API,APP\" --prefix-colors \"cyan,magenta\" \"npm:server\" \"npm:start\"",
    "test": "npm run test:app && npm run test:api",
    "test:app": "npm --prefix frontend test",
    "test:api": "npm --prefix backend test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "doctor": "npm --prefix frontend run doctor",
    "verify": "npm run lint && npm test && npm run doctor",
    "verify:deploy": "node backend/scripts/verify-deployment.js",
    "ai:configure": "node backend/scripts/configure-ai.js",
    "ai:status": "node backend/scripts/configure-ai.js --check",
    "assets": "npm --prefix frontend run assets",
    "sounds": "npm --prefix frontend run sounds",
    "legal:export": "npm --prefix frontend run legal:export",
    "build:preview": "npm --prefix frontend run build:preview",
    "build:prod": "npm --prefix frontend run build:prod"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "7.37.5",
    "globals": "14.0.0"
  },
  "dependencies": {
    "expo": "^58.0.26"
  }
}
