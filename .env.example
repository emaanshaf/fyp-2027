# Copy this file to .env and fill in your own key to enable the live
# Claude AI responses in the Islamic AI Assistant / Zakat AI tab.
# Without this key, the app still works fully using its offline
# knowledge base (src/ai/islamicKnowledge.js) — no functionality is lost.
#
# Get a key from https://console.anthropic.com/
#
# IMPORTANT: EXPO_PUBLIC_ vars are compiled into the JS bundle and are
# visible to anyone who inspects the shipped app. Do not use a key with
# a high spending limit for production releases — for a public app,
# proxy this call through your own backend instead.
EXPO_PUBLIC_ANTHROPIC_API_KEY=
