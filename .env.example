# Server-side key for the live Claude AI responses in the Islamic AI
# Assistant / Zakat AI tab. Without it the app still works fully using its
# offline knowledge base (src/ai/islamicKnowledge.js) — no functionality is
# lost, and the app says so in Settings instead of failing silently.
#
# Get a key from https://console.anthropic.com/
#
# This is deliberately NOT an EXPO_PUBLIC_ var. Every EXPO_PUBLIC_ value is
# compiled into the JS bundle and can be read out of the shipped app, so a key
# there is spendable by anyone who installs it. The app calls POST /api/ai/chat
# on our own server (server/routes/ai.js), which authenticates the user and
# rate-limits per account; only the server ever sees this key.
ANTHROPIC_API_KEY=
# Optional overrides.
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MAX_TOKENS=700

# Copy this file to .env and fill in your own values to enable real
# accounts (email/password sign-in) and cross-device data sync via
# Firebase. Without these, the app still works fully in guest/local-only
# mode — no functionality is lost.
#
# Get these from https://console.firebase.google.com:
# 1. Create a project (free Spark plan is enough).
# 2. Add a "Web app" to the project to get the config values below.
# 3. Authentication > Sign-in method > enable Email/Password.
# 4. Firestore Database > Create database, then paste firestore.rules
#    (see repo root) into Firestore > Rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Backend API - PostgreSQL Database
# Option 1: Local PostgreSQL (install from https://www.postgresql.org/download/windows/)
# Option 2: Supabase (free) - https://supabase.com
# Option 3: Neon (free) - https://neon.tech
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/qitabe_noor
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qitabe_noor
DB_USER=postgres
DB_PASSWORD=your_password

# Backend API Server
PORT=3001
JWT_SECRET=change-this-to-a-random-string-in-production
JWT_EXPIRES_IN=30d
CORS_ORIGIN=*

# Backend API URL (frontend connects to this)
EXPO_PUBLIC_API_URL=http://localhost:3001/api
