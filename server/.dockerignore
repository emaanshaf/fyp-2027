# node_modules is reinstalled inside the image by `npm ci`. Copying the host's
# would both bloat the context and ship binaries built for the wrong platform.
node_modules

# The development file-backed store. It holds real local accounts and must
# never be baked into an image.
.data

# Secrets. The container takes its configuration from the environment; a .env
# copied into the image would be readable by anyone who pulls it.
.env
.env.*
!.env.example

# Nothing here affects the running server.
Dockerfile
.dockerignore
*.md
npm-debug.log*
.DS_Store
