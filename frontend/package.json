{
  "name": "qitabe-noor-app",
  "version": "1.0.0",
  "private": true,
  "main": "App.js",
  "description": "Qitab-e-Noor mobile app (Expo SDK 57 / React Native 0.86). Offline-first; talks to ../backend over HTTP.",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "doctor": "expo-doctor",
    "assets": "node scripts/generate-assets.js",
    "sounds": "node scripts/generate-reminder-sounds.js",
    "legal:export": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-legal.mjs",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/drawer": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "axios": "^1.7.2",
    "expo": "~58.0.26",
    "expo-av": "~15.0.2",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-local-authentication": "~58.0.3",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-sensors": "~58.0.5",
    "expo-sharing": "~58.0.23",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "firebase": "^12.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "babel-preset-expo": "^57.0.10",
    "expo-doctor": "^1.21.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react-refresh": "^0.14.2",
    "react-test-renderer": "19.2.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av",
          "firebase"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "collectCoverageFrom": [
      "src/services/**/*.js",
      "src/data/curriculum.js"
    ]
  }
}
