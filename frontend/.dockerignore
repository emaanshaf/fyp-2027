# node_modules is reinstalled inside the image by `npm ci`. Copying the
# host's would both bloat the context and ship binaries built for the wrong
# platform.
node_modules

# Build output and native project dirs. The web build regenerates dist/, and
# android/ios are irrelevant to a web image.
dist
web-build
android
ios
.expo
.expo-shared

# Secrets. Containers take their configuration from the environment.
.env
.env.*
!.env.example

# Nothing here affects the built image.
.git
.github
*.md
npm-debug.log*
.DS_Store
